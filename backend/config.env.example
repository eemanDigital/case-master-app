# ==========================================
# TEMPLATE — copy to config.env and fill in.
# NEVER commit a real config.env.
# ==========================================

NODE_ENV=development
PORT=5000

# --- Secrets (required) ---------------------------------------------
# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Fields encrypted with this key (payment card, address, date of birth,
# taxId, billing address) become permanently unreadable if it is lost.
ENCRYPTION_KEY=

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=90d

# --- Rate limiting ---------------------------------------------------
# Rate limiting is ON by default. Only set this to true for local debugging;
# it disables brute-force protection on login, forgot-password and 2FA.
# DISABLE_RATE_LIMIT=false

# --- Third party (optional) ------------------------------------------
SENDINBLUE_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173